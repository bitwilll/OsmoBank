{
  "name": "osmobank",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OsmoBank — member-owned DAO bank: multichain wallets, venture investing, on-ledger dividends, governance.",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test 'tests/*.test.js'",
    "db:migrate": "node scripts/migrate.mjs",
    "bundle:wallet": "esbuild vendor-src/wallet-libs.js --bundle --format=esm --outfile=public/vendor/wallet-libs.js --target=es2022"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@simplewebauthn/server": "^13.3.2",
    "ethers": "^6.13.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0",
    "@scure/bip32": "^1.6.0",
    "@scure/bip39": "^1.4.0",
    "@scure/btc-signer": "^1.6.0",
    "@simplewebauthn/browser": "^13.3.0",
    "esbuild": "^0.25.0",
    "qrcode-generator": "^1.5.0"
  }
}
